<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .error-box {
      max-width: 400px;
      margin: 1em auto;
      padding: 1em;
      background-color: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
      border-radius: 5px;
      display: none;
    }
    .login-form{
  background-image: linear-gradient(to top, #0f2746 0%, #194c74 100%);
  height: 25rem;
  width: 61%;
  margin: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 8px;

}
  </style>
</head>
<body>
  {{> navbar}}

  <h1>Login</h1>

  <!-- Error Box -->
  <div id="errorBox" class="error-box"></div>
<div class="login-form">
  <form action="/users/login" method="POST" style="max-width: 400px; margin: auto;">
    <label for="email">Email:</label>
    <input type="email" name="email" id="email" required placeholder="Enter your email" />

    <label for="password">Password:</label>
    <input type="password" name="password" id="password" required placeholder="Enter your password" />

    <label for="userType">Login as:</label>
<select name="userType" id="userType" required>
  <option value="">-- Select Role --</option>
  <option value="renter">Renter</option>
  <option value="owner">Owner</option>
</select>

    <button type="submit">Login</button>
  </form>
  </div>

  <p style="text-align:center;">Don't have an account? <a href="/users/signup">Sign Up</a></p>

  <script>
    const params = new URLSearchParams(window.location.search);
    const error = params.get('error');
    if (error) {
      const box = document.getElementById('errorBox');
      box.textContent = decodeURIComponent(error);
      box.style.display = 'block';
    }
  </script>
</body>
</html>
